{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022"],
    "noEmit": true,
    "checkJs": false,
    "skipLibCheck": true,
    "typeRoots": ["../.probe"],
    "baseUrl": ".",
    "paths": {
      "@package/*": ["../.probe/@package/*"],
      "@special/*": ["../.probe/@special/*"],
      "@side-only/*": ["../.probe/@side-only/*"]
    }
  },
  "include": [
    "./**/*.js",
    "../.probe/@special/**/*.d.ts",
    "../.probe/@side-only/**/*.d.ts"
  ],
  "exclude": ["./exported", "./probe"]
}
